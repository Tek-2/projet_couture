{% extends 'base.html.twig' %}

{% block title %}{{ modele_location.libelle }}{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="row">

        {# ================= GALERIE ================= #}
        <div class="col-md-6">

            {% set mainPhoto = main_photo %}

            <img
                id="mainImage"
                class="img-fluid rounded shadow mb-3"
                src="{{ mainPhoto ? mainPhoto.url : asset('images/no-image.jpg') }}"
            >

            <div class="d-flex gap-2">

                {% for photo in photos %}
                    <img
                        src="{{ photo.url }}"
                        class="img-thumbnail"
                        style="width:80px; cursor:pointer;"
                        onclick="document.getElementById('mainImage').src=this.src"
                    >
                {% endfor %}

            </div>

        </div>

        {# ================= INFOS ================= #}
        <div class="col-md-6">

            <h1>{{ modele_location.libelle }}</h1>

            <h3 class="text-primary">
                {{ modele_location.prixLocation }} €
            </h3>

            <p>{{ modele_location.description }}</p>

            <hr>

            {# ================= COULEURS ================= #}
            <h5>Couleur</h5>

            <div class="d-flex gap-2 flex-wrap">

                {% for couleur in couleurs %}
                    <button class="btn-couleur"
                            data-id="{{ couleur.id }}"
                            title="{{ couleur.getNomCouleur }}"
                            style="
                                width: 35px;
                                height: 35px;
                                border-radius: 50%;
                                border: 2px solid #ddd;
                                background-image: url('{{ couleur.getImageCouleur }}');
                                background-size: cover;
                                background-position: center;
                                cursor: pointer;
                            ">
                    </button>
                {% endfor %}

            </div>

            {# ================= TAILLES ================= #}
            <h5 class="mt-3">Taille</h5>

            <div class="d-flex gap-2 flex-wrap">

                {% for taille in tailles %}
                    <button class="btn btn-outline-secondary btn-taille"
                            data-taille="{{ taille }}">
                        {{ taille }}
                    </button>
                {% endfor %}

            </div>

            {# ================= STOCK ================= #}
            <div class="mt-4">
                <div id="stockInfo" class="alert alert-secondary">
                    Sélectionnez une couleur et une taille
                </div>

            </div>

            <button id="addToShowroom" class="btn btn-primary mt-3">
                Ajouter à mon Showroom
            </button>
                        
            {# <a href="{{ path('app_showroom_add', {id: modele_location.id}) }}">
                Ajouter à mon Showroom
            </a>

            N'apparait pas ppour l'ibnstant
            <button id="btnLouer" class="btn btn-primary w-100 mt-3" disabled>
                Louer ce modèle
            </button>#}

        </div>

    </div>

</div>



<script>
let selectedColor = null;
let selectedSize = null;
let selectedStockId = null;

const stocks = {{ stocks_js|json_encode|raw }};

document.querySelectorAll('.btn-couleur').forEach(btn => {
    btn.addEventListener('click', () => {

        selectedColor = btn.dataset.id;

        // reset visuel
        document.querySelectorAll('.btn-couleur')
            .forEach(b => b.classList.remove('selected'));

        // sélection visuelle
        btn.classList.add('selected');

        updateStock();
    });
});
document.querySelectorAll('.btn-taille').forEach(btn => {
    btn.addEventListener('click', () => {

        selectedSize = btn.dataset.taille;

        document.querySelectorAll('.btn-taille')
            .forEach(b => b.classList.remove('selected'));

        btn.classList.add('selected');

        updateStock();
    });
});

function updateStock() {

    if (!selectedColor || !selectedSize) {
        selectedStockId = null;
        return;
    }

    const match = stocks.find(s =>
        s.couleur.id == selectedColor &&
        s.taille == selectedSize
    );

    if (match) {
        selectedStockId = match.id;

        document.getElementById('stockInfo').innerHTML =
            "Disponible : " + match.quantite + " pièce(s)";
    } else {
        selectedStockId = null;

        document.getElementById('stockInfo').innerHTML =
            "<span class='text-danger'>Non disponible</span>";
    }
}

document.getElementById('addToShowroom').addEventListener('click', () => {

    if (!selectedStockId) {
        alert("Sélectionnez une taille et une couleur disponibles");
        return;
    }

    window.location.href = "/showroom/add/" + selectedStockId;
});

</script>
<style>
.btn-couleur.selected {
        border: 3px solid #000 !important;
        transform: scale(1.1);
    }

    .btn-taille.selected {
        background-color: #000 !important;
        color: #fff !important;
    }

    .btn-couleur,
    .btn-taille {
        transition: all 0.2s ease;
    }
    </style>
{% endblock %}