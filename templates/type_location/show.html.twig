{% extends 'base.html.twig' %}

{% block title %}Détail du type de location{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fa fa-tag me-2"></i> Détail du type de location
                    </h4>
                </div>

                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted w-50">Id</th>
                                <td>{{ type_location.id }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Libellé</th>
                                <td>{{ type_location.libelle }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a class="btn btn-secondary" href="{{ path('app_type_location_index') }}">
                        <i class="fa fa-arrow-left"></i> Retour
                    </a>

                    <div class="d-flex gap-2">
                        <a class="btn btn-warning" href="{{ path('app_type_location_edit', {'id': type_location.id}) }}">
                            <i class="fa fa-edit"></i> Modifier
                        </a>

                        {{ include('type_location/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
