{% extends 'base.html.twig' %}

{% block title %}Détail de la couleur{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fa fa-palette me-2"></i> Détail de la couleur
                    </h4>
                </div>

                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted w-50">Id</th>
                                <td>{{ couleur.id }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Nom couleur</th>
                                <td>{{ couleur.nomCouleur }}</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Image</th>
                                <td>{{ couleur.image }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a class="btn btn-secondary" href="{{ path('app_couleur_index') }}">
                        <i class="fa fa-arrow-left"></i> Retour
                    </a>

                    <div class="d-flex gap-2">
                        <a class="btn btn-warning" href="{{ path('app_couleur_edit', {'id': couleur.id}) }}">
                            <i class="fa fa-edit"></i> Modifier
                        </a>

                        {{ include('couleur/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
