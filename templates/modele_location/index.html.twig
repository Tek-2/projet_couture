{% extends 'base.html.twig' %}

{% block title %}Modèles de location{% endblock %}

{% block body %}
    <h1>Dressing</h1>

    <div class="table-contaner">
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Libellé</th>
                    <th>Prix Location</th>
                    <th>Prix Achat</th>
                    <th>Tissu</th>
                    <th>Silhouette</th>
                    <th>Longueur</th>
                    <th>Longueur Manches</th>
                    <th>Forme Col</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for modele_location in modele_locations %}
                <tr>
                    <td>{{ modele_location.id }}</td>
                    <td>{{ modele_location.libelle }}</td>
                    <td>{{ modele_location.prixLocation ? modele_location.prixLocation|number_format(2, ',', ' ') ~ ' €' }}</td>
                    <td>{{ modele_location.prixAchat ? modele_location.prixAchat|number_format(2, ',', ' ') ~ ' €' }}</td>
                    <td>{{ modele_location.tissu }}</td>
                    <td>{{ modele_location.silhouette }}</td>
                    <td>{{ modele_location.longueur }}</td>
                    <td>{{ modele_location.longueurManches }}</td>
                    <td>{{ modele_location.formeCol }}</td>
                    <td>{{ modele_location.description }}</td>
                    <td>
                        <a class="btn btn-primary" href="{{ path('app_modele_location_show', {'id': modele_location.id}) }}">
                            <i class="fa fa-eye"></i>
                        </a>
                        <a class="btn btn-warning" href="{{ path('app_modele_location_edit', {'id': modele_location.id}) }}">
                            <i class="fa fa-edit"></i>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="11">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="create-btn">
        <a class="btn btn-success" href="{{ path('app_modele_location_new') }}">Ajouter un modèle</a>
    </div>
{% endblock %}
